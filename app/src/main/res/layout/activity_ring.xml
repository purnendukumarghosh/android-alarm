<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_stat_alarm"
        android:tint="@color/ring_subtext" />

    <TextView
        android:id="@+id/ringTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-thin"
        android:textColor="@color/ring_text"
        android:textSize="72sp" />

    <TextView
        android:id="@+id/ringLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/ring_text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1.4" />

    <Button
        android:id="@+id/snoozeButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:backgroundTint="@color/snooze_bg"
        android:text="@string/snooze"
        android:textColor="@color/ring_text"
        android:textSize="18sp" />

    <Button
        android:id="@+id/dismissButton"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/dismiss_bg"
        android:text="@string/dismiss"
        android:textColor="@color/ring_text"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
