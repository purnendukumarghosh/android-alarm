<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Single dark "Neon Night" theme. Screens set GlowBackgroundDrawable on their root. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg0</item>
        <item name="android:statusBarColor">@color/bg1</item>
        <item name="android:navigationBarColor">@color/bg0</item>
        <item name="android:colorPrimary">@color/bg1</item>
        <item name="android:colorPrimaryDark">@color/bg1</item>
        <item name="android:colorAccent">@color/neon_cyan</item>
        <item name="android:colorControlNormal">@color/text2</item>
        <item name="android:colorControlActivated">@color/neon_cyan</item>
        <item name="android:colorControlHighlight">#2600E5FF</item>
        <item name="android:textColorPrimary">@color/text1</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorHint">@color/text3</item>
        <item name="android:textViewStyle">@style/Widget.Neon.TextView</item>
        <item name="android:editTextStyle">@style/Widget.Neon.EditText</item>
        <item name="android:buttonStyle">@style/Widget.Neon.Button</item>
        <item name="android:alertDialogTheme">@style/NeonDialog</item>
        <item name="android:timePickerDialogTheme">@style/NeonDialog</item>
        <item name="android:windowAnimationStyle">@style/NeonWindowAnimation</item>
    </style>

    <style name="RingTheme" parent="AppTheme">
        <item name="android:statusBarColor">@color/bg0</item>
        <item name="android:navigationBarColor">@color/bg0</item>
    </style>

    <style name="NeonDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/neon_cyan</item>
        <item name="android:colorBackground">@color/bg2</item>
        <item name="android:textColorPrimary">@color/text1</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:fontFamily">@font/manrope</item>
    </style>

    <!-- Bottom sheets: full-width dialog without frame, dimmed scrim. -->
    <style name="NeonBottomSheet" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@style/NeonSheetAnimation</item>
        <item name="android:colorAccent">@color/neon_cyan</item>
        <item name="android:textViewStyle">@style/Widget.Neon.TextView</item>
    </style>

    <style name="NeonWindowAnimation" parent="@android:style/Animation.Activity" />
    <style name="NeonSheetAnimation">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="Widget.Neon.TextView" parent="android:Widget.Material.TextView">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/text1</item>
    </style>

    <style name="Widget.Neon.EditText" parent="android:Widget.Material.EditText">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/text1</item>
        <item name="android:textColorHint">@color/text3</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Widget.Neon.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text1</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Type scale (Manrope). -->
    <style name="Text" />
    <style name="Text.Display">
        <item name="android:fontFamily">@font/manrope_extralight</item>
        <item name="android:textSize">64sp</item>
        <item name="android:textColor">@color/text1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Text.Headline">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/text1</item>
    </style>
    <style name="Text.Title">
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text1</item>
    </style>
    <style name="Text.Body">
        <item name="android:fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Text.Caption">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text3</item>
    </style>
    <!-- Section header ("VOICE", "REPEAT"): small caps with tracking. -->
    <style name="Text.Overline">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text2</item>
    </style>
    <style name="Text.Button">
        <item name="android:fontFamily">@font/manrope_extrabold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
